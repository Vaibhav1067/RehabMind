# TLS-terminating reverse proxy. Only this container publishes ports.
# TLS_ISSUER=internal (default) uses Caddy's local CA, for a demo on localhost.
# For a public hostname set SITE_ADDRESS to it and TLS_ISSUER=acme: Caddy then obtains a
# public certificate automatically (ports 80 and 443 must be reachable from the internet).
{
	admin off
}

{$SITE_ADDRESS:localhost} {
	tls {
		issuer {$TLS_ISSUER:internal}
	}
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}
	request_body {
		max_size 3MB
	}
	reverse_proxy web:3000
}
